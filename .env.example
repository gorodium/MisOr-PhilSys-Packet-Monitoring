# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/philsys_packet_monitoring?schema=public"

# Runtime behavior
DEMO_MODE="true"
APP_DEFAULT_ROLE="admin"
TRUSTED_AUTH_HEADER="false"
AUTH_ROLE_HEADER="x-philsys-role"
RATE_LIMIT_MAX="120"
RATE_LIMIT_WINDOW_SECONDS="60"

# Google Sheets
GOOGLE_SPREADSHEET_ID=""
GOOGLE_SHEET_NAME="Packets"
GOOGLE_PACKET_COLUMN_NAME="Packet"
GOOGLE_ISSUE_CATEGORY_COLUMN_NAME="Issue Category"
GOOGLE_OUTPUT_FILED_STATUS_COLUMN="Filed Status"
GOOGLE_OUTPUT_TICKET_NUMBER_COLUMN="Ticket Number"
GOOGLE_OUTPUT_REMARKS_COLUMN="Remarks"
GOOGLE_OUTPUT_LAST_UPDATED_COLUMN="Last Updated"
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# Matrix adapter
MATRIX_MODE="demo"
MATRIX_BASE_URL=""
MATRIX_API_KEY=""
MATRIX_FETCH_TICKETS_PATH=""
MATRIX_TICKET_DETAILS_PATH=""
MATRIX_SEARCH_PATH=""
MATRIX_CREATE_TICKET_PATH=""
MATRIX_REPLIES_PATH=""

# Automation
AUTO_TICKET_CREATION_ENABLED="false"
SYNC_INTERVAL_SECONDS="300"
TICKET_BODY_TEMPLATE="Good day.\n\nPlease check the following PhilSys data packet:\n\nPacket: {{packetCode}}\nConcern Type: {{issueCategory}}\n\nThis packet was detected from the monitoring board and has not yet been filed in an existing Matrix ticket.\n\nThank you."
