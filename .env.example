DATABASE_URL="postgresql://username:password@host/database?sslmode=require" # Replace with your PostgreSQL connection string, or "file:./dev.db" for SQLite

DEMO_MODE="false"
APP_DEFAULT_ROLE="admin"
TRUSTED_AUTH_HEADER="false"
AUTH_ROLE_HEADER="x-philsys-role"
RATE_LIMIT_MAX="120"
RATE_LIMIT_WINDOW_SECONDS="60"

GOOGLE_SPREADSHEET_ID=""
GOOGLE_SHEET_NAME="Packets"
GOOGLE_PACKET_COLUMN_NAME="Packet ID"
GOOGLE_ISSUE_CATEGORY_COLUMN_NAME="Issue Category"
GOOGLE_OUTPUT_FILED_STATUS_COLUMN="Filed Status"
GOOGLE_OUTPUT_TICKET_NUMBER_COLUMN="Ticket Number"
GOOGLE_OUTPUT_REMARKS_COLUMN="Remarks"
GOOGLE_OUTPUT_LAST_UPDATED_COLUMN="Last Updated"
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_API_KEY=""

MATRIX_MODE="http"
MATRIX_BASE_URL="https://matrix.philsys.gov.ph"
MATRIX_API_KEY=""
MATRIX_FETCH_TICKETS_PATH="/issues.json?project_id=philsys-it-support-ticketing-2026&status_id=open&limit=100"
MATRIX_TICKET_DETAILS_PATH="/issues/{ticketId}.json?include=journals"
MATRIX_SEARCH_PATH="/issues.json?project_id=philsys-it-support-ticketing-2026&subject={packetCode}&limit=25"
MATRIX_CREATE_TICKET_PATH="/issues.json"
MATRIX_REPLIES_PATH="/issues/{ticketId}.json?include=journals"

AUTO_TICKET_CREATION_ENABLED="false"
SYNC_INTERVAL_SECONDS="300"
TICKET_BODY_TEMPLATE="Good day.\n\nPlease check the following PhilSys data packet:\n\nPacket: {{packetCode}}\nConcern Type: {{issueCategory}}\n\nThis packet was detected from the monitoring board and has not yet been filed in an existing Matrix ticket.\n\nThank you."
